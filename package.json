{
  "name": "js-ts-beginner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\" && npm run build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "audit:questions": "node scripts/audit-question-leaks.mjs",
    "audit:clarity": "node scripts/audit-question-clarity.mjs",
    "audit:dialogues": "node scripts/audit-dialogues.mjs",
    "audit:granularity": "node scripts/audit-granularity.mjs",
    "audit:dom": "node scripts/audit-dom-learning.mjs",
    "audit:project": "node scripts/audit-project-alignment.mjs",
    "audit:grading": "node --experimental-strip-types scripts/audit-grading.mjs",
    "audit:learning": "node scripts/audit-learning-quality.mjs",
    "audit:learning-engine": "node --experimental-strip-types scripts/audit-learning-engine.mjs",
    "audit:extensions": "node --experimental-strip-types scripts/audit-extensions.mjs",
    "audit:client-boundary": "node scripts/audit-client-course-boundary.mjs",
    "audit:client-bundles": "node scripts/audit-client-bundles.mjs",
    "audit:progress-store": "node --experimental-strip-types scripts/audit-progress-store.mjs",
    "audit:review-data-flow": "node --experimental-strip-types scripts/audit-review-data-flow.mjs",
    "audit:trim-client": "node scripts/audit-trim-client.mjs",
    "audits": "npm run audit:questions && npm run audit:clarity && npm run audit:dialogues && npm run audit:granularity && npm run audit:dom && npm run audit:project && npm run audit:grading && npm run audit:learning && npm run audit:learning-engine && npm run audit:extensions && npm run audit:client-boundary && npm run audit:progress-store && npm run audit:review-data-flow && npm run audit:trim-client",
    "e2e:install": "agent-browser install",
    "e2e:run": "node scripts/e2e-agent-browser.mjs all",
    "e2e": "npm run build:clean && npm run e2e:run",
    "e2e:catalog": "npm run build:clean && node scripts/e2e-agent-browser.mjs catalog",
    "e2e:learning": "npm run build:clean && node scripts/e2e-agent-browser.mjs learning review",
    "e2e:extensions": "npm run build:clean && node scripts/e2e-agent-browser.mjs extensions",
    "e2e:ui": "npm run build:clean && node scripts/e2e-agent-browser.mjs ui",
    "e2e:review": "npm run build:clean && node scripts/e2e-agent-browser.mjs review",
    "verify:static": "npm run lint && npm run typecheck && npm run audits && npm run build:clean && npm run audit:client-bundles",
    "verify": "npm run lint && npm run typecheck && npm run audits && npm run build:clean && npm run audit:client-bundles && npm run e2e:run"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "monaco-editor": "^0.56.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.15"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "agent-browser": "0.37.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
